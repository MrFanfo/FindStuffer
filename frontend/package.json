{
  "name": "findstuff-web",
  "private": true,
  "version": "1.7.5",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "perf": "node ../scripts/frontend-perf-check.mjs",
    "typecheck": "tsc -b --pretty false",
    "typecheck:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.app.json --pretty false",
    "check:architecture": "node ../scripts/check-frontend-architecture.mjs",
    "check:bundle": "node ../scripts/check-frontend-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "test:e2e:pagination": "playwright test --grep \"cursor pagination\""
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "jsbarcode": "^3.12.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.18"
  }
}
