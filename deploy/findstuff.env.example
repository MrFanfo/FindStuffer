# The installer starts with LAN HTTP. Change to true after trusted HTTPS is configured.
FINDSTUFF_SECURE_COOKIES=false
FINDSTUFF_DATA_DIR=/var/lib/findstuff
FINDSTUFF_FRONTEND_DIST=/opt/findstuff/frontend/dist
FINDSTUFF_REQUIRE_AUTH=true
FINDSTUFF_ADMIN_USERNAME=admin
FINDSTUFF_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Legacy native systemd installs do not support the Docker host updater.
FINDSTUFF_SOFTWARE_UPDATE_ENABLED=false

# Advanced first-run defaults; normally configure AI in Manage > Integrations.
# AI Scan requires a vision-capable model.
FINDSTUFF_AI_ENDPOINT=
FINDSTUFF_AI_API_KEY=
FINDSTUFF_AI_MODEL=

# Optional external multipart speech-to-text endpoint.
FINDSTUFF_STT_ENDPOINT=
FINDSTUFF_STT_API_KEY=
FINDSTUFF_STT_MODEL=

# Advanced first-run defaults; normally configure MQTT in Manage > Integrations.
FINDSTUFF_MQTT_HOST=
FINDSTUFF_MQTT_PORT=1883
FINDSTUFF_MQTT_USERNAME=
FINDSTUFF_MQTT_PASSWORD=
FINDSTUFF_MQTT_BASE_TOPIC=findstuff
FINDSTUFF_MQTT_DISCOVERY_PREFIX=homeassistant
FINDSTUFF_MQTT_CLIENT_ID=findstuff
FINDSTUFF_MQTT_PUBLISH_INTERVAL_SECONDS=60

FINDSTUFF_AUTO_BACKUP_ENABLED=true
FINDSTUFF_BACKUP_DIR=/var/lib/findstuff/backups
FINDSTUFF_BACKUP_KEEP=14
FINDSTUFF_BACKUP_CHECK_INTERVAL_SECONDS=3600
