[Unit]
Description=Back up Findstuff inventory

[Service]
Type=oneshot
User=findstuff
Group=findstuff
WorkingDirectory=/opt/findstuff
EnvironmentFile=-/etc/findstuff.env
Environment=FINDSTUFF_DATA_DIR=/var/lib/findstuff
ExecStart=/opt/findstuff/.venv/bin/findstuff backup --output /var/lib/findstuff/backups --keep 14
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/findstuff
