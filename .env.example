# Pin a release tag for predictable upgrades, for example :v1.1.0.
FINDSTUFF_IMAGE=ghcr.io/mrfanfo/findstuffer:latest

# Listen on the host's loopback and LAN interfaces. Keep authentication enabled,
# and never port-forward this plain HTTP port to the public internet.
FINDSTUFF_BIND_ADDRESS=0.0.0.0
FINDSTUFF_PORT=8000
FINDSTUFF_UID=10001
FINDSTUFF_GID=10001

# Docker installations require administrator authentication.
FINDSTUFF_REQUIRE_AUTH=true
FINDSTUFF_ADMIN_USERNAME=admin
FINDSTUFF_ADMIN_PASSWORD=CHANGE_ME_10_CHARS_MIN
FINDSTUFF_SOFTWARE_UPDATE_ENABLED=false
FINDSTUFF_SECURE_COOKIES=false

# Outbound URL safety. Add trusted image hosts as a comma-separated exact list.
FINDSTUFF_EXTERNAL_IMAGE_HOSTS=images.openfoodfacts.org
# Set true only if ntfy is intentionally hosted on your LAN/private address.
FINDSTUFF_ALLOW_PRIVATE_INTEGRATION_URLS=false

# Advanced first-run defaults only. Normally configure AI in Manage > Integrations.
# AI Scan needs an OpenAI-compatible endpoint and a vision-capable model.
FINDSTUFF_AI_ENDPOINT=
FINDSTUFF_AI_API_KEY=
FINDSTUFF_AI_MODEL=

# Optional multipart speech-to-text endpoint.
FINDSTUFF_STT_ENDPOINT=
FINDSTUFF_STT_API_KEY=
FINDSTUFF_STT_MODEL=

# Advanced first-run defaults only. Normally configure MQTT in Manage > Integrations.
FINDSTUFF_MQTT_HOST=
FINDSTUFF_MQTT_PORT=1883
FINDSTUFF_MQTT_USERNAME=
FINDSTUFF_MQTT_PASSWORD=
FINDSTUFF_MQTT_BASE_TOPIC=findstuff
FINDSTUFF_MQTT_DISCOVERY_PREFIX=homeassistant
FINDSTUFF_MQTT_CLIENT_ID=findstuff
FINDSTUFF_MQTT_PUBLISH_INTERVAL_SECONDS=60

# Local backups are stored inside the persistent volume.
FINDSTUFF_AUTO_BACKUP_ENABLED=true
FINDSTUFF_BACKUP_DIR=/app/data/backups
FINDSTUFF_BACKUP_KEEP=14
FINDSTUFF_BACKUP_CHECK_INTERVAL_SECONDS=3600
